{
	"name": "blog",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.21.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "next --turbopack",
		"build": "next build",
		"postbuild": "pagefind --site out --output-path out/_pagefind",
		"preview": "rm -rf .preview && mkdir -p .preview && cp -r out .preview/blog && echo 'http://localhost:3001/blog/' && python3 -m http.server 3001 -d .preview"
	},
	"dependencies": {
		"@giscus/react": "3.1.0",
		"@radix-ui/react-slot": "1.2.4",
		"@radix-ui/react-switch": "1.2.6",
		"@tabler/icons-react": "3.36.1",
		"@theguild/remark-mermaid": "0.3.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "0.548.0",
		"next": "16.1.1",
		"next-view-transitions": "0.3.4",
		"nextra": "4.6.1",
		"nextra-theme-blog": "4.6.0",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"tailwind-merge": "3.4.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.1.18",
		"@types/node": "24.10.2",
		"@types/react": "19.2.7",
		"pagefind": "1.4.0",
		"postcss": "8.5.6",
		"tailwindcss": "4.1.18",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.3"
	}
